# URL del backend. En dev el proxy de Vite maneja /api, así que puede quedar vacío.
# En producción (Render) apunta a la URL pública de easylit-api.
VITE_API_URL=https://easylit-api.onrender.com

# Desarrollo: dónde corre el backend Django (proxy de /api)
VITE_PROXY_API=http://localhost:8000

# Login con Firebase (Configuración del proyecto → Tus apps → app web).
# Si se dejan vacías, se usa el login propio de la app (desarrollo local).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
