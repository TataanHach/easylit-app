# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.

# Entorno: config.settings.dev  o  config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Secreto de Django (en prod lo genera Render automáticamente)
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Dominios permitidos, separados por coma (prod)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (prod usa la de Render; en dev se usa SQLite si se omite)
DATABASE_URL=postgres://usuario:clave@host:5432/easylit

# Redis para Celery (en dev local: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# URL del frontend, para CORS (prod)
FRONTEND_URL=https://easylit-web.onrender.com

# Clave de la API de Gemini (Google AI Studio)
GEMINI_API_KEY=tu-clave-de-gemini
