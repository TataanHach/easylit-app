# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.

# Entorno: config.settings.dev  o  config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Secreto de Django (en prod lo genera Render automáticamente)
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Dominios permitidos, separados por coma (prod)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (prod usa la de Render; en dev se usa SQLite si se omite)
DATABASE_URL=postgres://usuario:clave@host:5432/easylit

# Redis para Celery (en dev local: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# URL del frontend, para CORS (prod)
FRONTEND_URL=https://easylit-web.onrender.com

# CORS en desarrollo: orígenes del frontend, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave de la API de Gemini (Google AI Studio). Vacía = modo simulado sin IA.
GEMINI_API_KEY=tu-clave-de-gemini
IA_MODEL=models/gemini-3.5-flash-lite
IA_TIMEOUT_SEGUNDOS=60
# Máximo de textos distintos de tablas por cada "Limpiar con IA" (cuota)
IA_MAX_TEXTOS_TABLA=300

# --- Reglas de negocio (el frontend las lee de /api/config/) ---
IVA_TASA=0.19
CONTRASENA_MIN=6
CONTRASENA_MAX=18
# Si lo subes, sube también client_max_body_size en frontend/nginx.conf
ARCHIVO_MAX_MB=20
INVITACION_DIAS_VIGENCIA=7

# --- Sesión (JWT) ---
JWT_ACCESS_MINUTOS=60
JWT_REFRESH_DIAS=7
